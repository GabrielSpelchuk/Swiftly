# ============================================================
# Backend (NestJS)
# ============================================================

NODE_ENV=development

PORT=3005

# Префікс маршрутів API. Порожній = маршрути в корені (/products).
# Поставте "api", якщо фронтенд і бекенд живуть на одному домені
# і nginx проксіює /api -> backend.
API_PREFIX=

CLIENT_HOST=http://localhost:3000

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=Swiftly

# Керовані БД (Neon, Supabase, Amazon RDS) вимагають SSL — інакше
# з'єднання падає з "connection is insecure". Локальний Postgres
# працює без нього.
DB_SSL=false

# synchronize переписує таблиці під себе за структурою entity
# і ЗДАТНИЙ знести дані. У production — тільки через міграції.
DB_SYNCHRONIZE=true

# ---------- JWT ----------
# ОБОВ'ЯЗКОВО замініть перед деплоєм.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-access-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Swagger ----------
# У production за замовчуванням вимкнено.
# Увімкнути безпечно можна лише за HTTPS.
SWAGGER_ENABLED=true

# ---------- Mail ----------
# Спосіб відправки обирається автоматично, пріоритет у Resend.

# Resend (рекомендовано). Листи йдуть через HTTPS API, тому працюють
# навіть там, де SMTP-порти заблоковані (напр. free-план Render).
# Ключ: resend.com -> API Keys -> Create API Key
# Під час безкоштовного тестування Resend надсилає лише на пошту,
# з якої ти зареєструвався. Для довільних адрес приєднай свій домен.
RESEND_API_KEY=
RESEND_FROM=Swiftly <onboarding@resend.dev>

# SMTP — запасний варіант для локальної розробки або платного хостингу.
# MAIL_HOST порожній -> листи не надсилаються, а посилання пишуться в лог.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@swiftly.local

# Адреса застосунку для посилань у листах (активація, скидання пароля).
APP_URL=http://localhost:3000