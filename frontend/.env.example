# Вбудовується в бандл ПІД ЧАС БУДІВНИЦТВА (npm run build),
# а не під час запуску. Тому після зміни цього файлу
# треба перезапустити dev-сервер або перебудувати образ.

# Абсолютна адреса API:
#   REACT_APP_API_URL=http://localhost:3005
#
# Або відносний шлях, коли API проксіюється тим самим доменом:
REACT_APP_API_URL=http://localhost:3005